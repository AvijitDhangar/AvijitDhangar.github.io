---
import Base from '../../../layouts/Base.astro';
import NoteRow from '../../../components/NoteRow.astro';
import { getGarden } from '../../../lib/garden.mjs';
import { withBase } from '../../../lib/url.mjs';
export function getStaticPaths() { return getGarden().topics.map((t) => ({ params: { topic: t.slug }, props: { t } })); }
const { t } = Astro.props;
---
<Base title={t.name} place="curiosities">
  <header class="topic-head" style={`--hue:${t.hue}`}>
    <div class="wrap">
      <a class="back" href={withBase('curiosities/')}>← Curiosities</a>
      <h1>{t.name}</h1>
    </div>
  </header>
  <div class="wrap">
    {t.note && (
      <div class="narrow" style="margin:2.5rem 0 3rem">
        <div class="prose" set:html={t.note.html} />
      </div>
    )}

    {t.current.length > 0 && (
      <section class="section">
        <h2>Exploring now</h2>
        <ul class="rows">{t.current.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {t.guides?.length > 0 && (
      <section class="section">
        <h2>Guides & Walkthroughs</h2>
        <ul class="rows">{t.guides.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {t.resources?.length > 0 && (
      <section class="section">
        <h2>Resources & References</h2>
        <ul class="rows">{t.resources.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {t.articles?.length > 0 && (
      <section class="section">
        <h2>Articles & Essays</h2>
        <ul class="rows">{t.articles.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {t.notes?.length > 0 && (
      <section class="section">
        <h2>Notes & Reflections</h2>
        <ul class="rows">{t.notes.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {t.past.length > 0 && (
      <section class="section past">
        <h2>Past explorations</h2>
        <ul class="rows">{t.past.map((n) => <NoteRow item={n} topics={false} />)}</ul>
      </section>
    )}

    {(t.projects.length > 0 || t.experiments.length > 0) && (
      <section class="section">
        <h2>Built</h2>
        <ul class="rows">
          {[...t.projects, ...t.experiments].map((p) => (
            <li class="row" style="grid-template-columns:1fr">
              <div>
                <h3>{p.link ? <a href={p.link}>{p.title}</a> : p.title}</h3>
                <p>{p.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
