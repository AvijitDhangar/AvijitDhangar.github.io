---
import Base from '../../layouts/Base.astro';
import Comments from '../../components/Comments.astro';
import NoteRow from '../../components/NoteRow.astro';
import SimklShowcase from '../../components/SimklShowcase.astro';
import { getGarden } from '../../lib/garden.mjs';
import { withBase } from '../../lib/url.mjs';
const g = getGarden();
const shown = g.topics.filter((t) => t.slug !== 'other');
for (let i = 1; i < shown.length; i++) {
  if (shown[i].hue === shown[i - 1].hue) {
    const pal = ['#1f9d6a', '#f97316', '#3b82f6', '#ec4899', '#f59e0b', '#8b5cf6', '#06b6d4', '#d946ef', '#10b981', '#6366f1', '#14b8a6', '#fb7185'];
    const curIdx = pal.indexOf(shown[i].hue);
    shown[i].hue = pal[(curIdx + 1) % pal.length];
  }
}
const rabbitHoles = g.rabbitHoles || g.explorations;
const current = rabbitHoles.filter((n) => n.status !== 'past');
const past = rabbitHoles.filter((n) => n.status === 'past');
---
<Base title="Curiosities" description="Interests, rabbit holes and curious pursuits." place="curiosities">
  <header class="page-head"><div class="wrap"><h1>Curiosities</h1><p>Subjects I explore because they are interesting, not because they must produce something.</p></div></header>
  <div class="wrap">
    <section class="section" style="padding-top:2rem">
      <div class="section-head"><h2>Long-term interests</h2><p>Areas I keep coming back to.</p></div>
      {shown.length > 0 ? (
        <div class="topics">
          {shown.map((t) => (
            <a class="topic" style={`--hue:${t.hue}`} href={withBase(`curiosities/${t.slug}/`)}>
              <h3>{t.name}</h3>
              <small>{[t.current.length && `${t.current.length} active`, t.writing.length && `${t.writing.length} written`].filter(Boolean).join(' · ')}</small>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-note">No topics published yet. Publish a note from Obsidian with <code>topics: [Topic Name]</code> and it will appear here.</p>
      )}
    </section>
    {current.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Current rabbit holes</h2></div>
        <ul class="rows">{current.map((n) => <NoteRow item={n} />)}</ul>
      </section>
    )}
    {past.length > 0 && (
      <section class="section past">
        <div class="section-head"><h2>Past rabbit holes</h2><p>Might revisit later.</p></div>
        <ul class="rows">{past.map((n) => <NoteRow item={n} />)}</ul>
      </section>
    )}
    <SimklShowcase />
    <Comments id="curiosities" title="Curiosities Discussion" description="Thoughts, recommendations, or a rabbit hole I should explore? Leave a note below." />
  </div>
</Base>
