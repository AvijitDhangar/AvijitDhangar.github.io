---
import Base from '../../../layouts/Base.astro';
import { withBase } from '../../../lib/url.mjs';
---

<Base title="Simkl Authorization" description="Authorize with Simkl via PKCE" place="curiosities">
  <div class="wrap auth-page-wrap">
    <div class="auth-card" id="auth-card">
      <div id="auth-loading" class="auth-state">
        <div class="auth-spinner" aria-hidden="true"></div>
        <h2>Authenticating with Simkl…</h2>
        <p class="auth-sub">Exchanging authorization code via PKCE (S256).</p>
      </div>

      <div id="auth-success" class="auth-state" hidden>
        <div class="auth-badge success">✓ Connected</div>
        <h2>Simkl Connected!</h2>
        <p class="auth-sub">Your live watch history and ratings are now linked.</p>
        
        <div class="token-helper-box">
          <p class="helper-title">🔑 GitHub Actions Secrets (Optional for Build-Time Sync):</p>
          <p class="helper-desc">If you want your static GitHub Pages build to also pre-fetch your watchlist, add this token as <code>SIMKL_USER_TOKEN</code> in your repo settings:</p>
          <div class="token-copy-row">
            <input type="password" id="token-input" readonly aria-label="Access Token" />
            <button type="button" id="copy-token-btn" class="btn btn-sm">Copy Token</button>
          </div>
        </div>

        <div class="auth-actions">
          <a href={withBase('curiosities/')} class="btn">Return to Curiosities →</a>
        </div>
      </div>

      <div id="auth-error" class="auth-state" hidden>
        <div class="auth-badge error">✕ Error</div>
        <h2>Authentication Failed</h2>
        <p id="error-message" class="auth-sub error-text">An unknown error occurred during token exchange.</p>
        <div class="auth-actions">
          <button type="button" id="retry-btn" class="btn">Try Again</button>
          <a href={withBase('curiosities/')} class="btn btn-outline">Back to Curiosities</a>
        </div>
      </div>

      <div id="auth-manual" class="auth-state" hidden>
        <div class="auth-badge info">ℹ️ Simkl PKCE</div>
        <h2>Simkl Browser Sign-In</h2>
        <p class="auth-sub">This page handles the OAuth PKCE redirect from Simkl.</p>
        <div class="auth-form">
          <label for="manual-client-id">Simkl Client ID:</label>
          <input type="text" id="manual-client-id" placeholder="Paste your Simkl Client ID here" />
          <button type="button" id="start-auth-btn" class="btn" style="margin-top:1rem; width:100%">Sign In with Simkl (PKCE)</button>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .auth-page-wrap {
    min-height: 65vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem 1rem;
  }
  .auth-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 2.5rem 2rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 16px 36px -12px rgba(0, 0, 0, 0.25);
  }
  .auth-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .auth-spinner {
    width: 44px;
    height: 44px;
    border: 3.5px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin-bottom: 0.5rem;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .auth-badge {
    font-family: monospace;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }
  .auth-badge.success {
    background: color-mix(in srgb, #10b981 18%, var(--surface));
    color: #10b981;
    border: 1px solid color-mix(in srgb, #10b981 35%, transparent);
  }
  .auth-badge.error {
    background: color-mix(in srgb, #ef4444 18%, var(--surface));
    color: #ef4444;
    border: 1px solid color-mix(in srgb, #ef4444 35%, transparent);
  }
  .auth-badge.info {
    background: color-mix(in srgb, var(--accent) 18%, var(--surface));
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }
  .auth-sub {
    font-size: 0.95rem;
    color: var(--ink-soft);
    margin: 0;
  }
  .error-text {
    color: #ef4444;
  }
  .token-helper-box {
    margin: 1.5rem 0 0.5rem;
    text-align: left;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1.1rem 1.2rem;
    width: 100%;
  }
  .helper-title {
    font-weight: 700;
    font-size: 0.86rem;
    margin: 0 0 0.4rem;
    color: var(--ink);
  }
  .helper-desc {
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin: 0 0 0.8rem;
    line-height: 1.4;
  }
  .token-copy-row {
    display: flex;
    gap: 0.5rem;
  }
  .token-copy-row input {
    flex-grow: 1;
    font-family: monospace;
    font-size: 0.82rem;
    padding: 0.45rem 0.65rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
  }
  .auth-actions {
    margin-top: 1.5rem;
    display: flex;
    gap: 0.8rem;
    justify-content: center;
  }
  .btn-sm {
    padding: 0.4rem 0.8rem;
    font-size: 0.82rem;
  }
  .btn-outline {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
  }
  .btn-outline:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .auth-form {
    width: 100%;
    text-align: left;
    margin-top: 1rem;
  }
  .auth-form label {
    display: block;
    font-size: 0.88rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .auth-form input {
    width: 100%;
    padding: 0.6rem 0.8rem;
    border-radius: 8px;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--ink);
    font-size: 0.95rem;
  }
</style>

<script>
  import { exchangeCodeForToken, initiateSimklAuth } from '../../../lib/simkl-pkce.js';

  async function handleCallback() {
    const loadingEl = document.getElementById('auth-loading');
    const successEl = document.getElementById('auth-success');
    const errorEl = document.getElementById('auth-error');
    const manualEl = document.getElementById('auth-manual');
    const errorMsgEl = document.getElementById('error-message');
    const tokenInput = document.getElementById('token-input');
    const copyBtn = document.getElementById('copy-token-btn');

    const params = new URLSearchParams(window.location.search);
    const code = params.get('code');
    const error = params.get('error') || params.get('error_description');

    if (error) {
      loadingEl.hidden = true;
      errorEl.hidden = false;
      errorMsgEl.textContent = `Simkl error: ${error}`;
      return;
    }

    if (!code) {
      loadingEl.hidden = true;
      manualEl.hidden = false;
      const storedId = localStorage.getItem('simkl_client_id') || '';
      const manualInput = document.getElementById('manual-client-id');
      if (manualInput && storedId) manualInput.value = storedId;
      return;
    }

    try {
      const data = await exchangeCodeForToken(code);
      loadingEl.hidden = true;
      successEl.hidden = false;

      if (tokenInput && data.access_token) {
        tokenInput.value = data.access_token;
      }

      if (copyBtn && tokenInput) {
        copyBtn.addEventListener('click', async () => {
          await navigator.clipboard.writeText(tokenInput.value);
          copyBtn.textContent = 'Copied!';
          setTimeout(() => (copyBtn.textContent = 'Copy Token'), 2000);
        });
      }

      // Auto-redirect after 3.5 seconds
      setTimeout(() => {
        window.location.href = '/curiosities/';
      }, 3500);
    } catch (err) {
      console.error('PKCE exchange error:', err);
      loadingEl.hidden = true;
      errorEl.hidden = false;
      errorMsgEl.textContent = err.message || 'Failed to exchange authorization code.';
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    handleCallback();

    const startBtn = document.getElementById('start-auth-btn');
    const manualInput = document.getElementById('manual-client-id');
    const retryBtn = document.getElementById('retry-btn');

    startBtn?.addEventListener('click', () => {
      const id = manualInput?.value?.trim();
      if (!id) {
        alert('Please enter your Simkl Client ID.');
        return;
      }
      initiateSimklAuth(id);
    });

    retryBtn?.addEventListener('click', () => {
      const id = localStorage.getItem('simkl_client_id');
      if (id) {
        initiateSimklAuth(id);
      } else {
        window.location.href = '/auth/simkl';
      }
    });
  });
</script>
