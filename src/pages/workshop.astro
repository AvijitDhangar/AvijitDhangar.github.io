---
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import { getGarden, slugify } from '../lib/garden.mjs';
import { liveApps } from '../data/projects.mjs';
import { withBase } from '../lib/url.mjs';

const g = getGarden();
const ordered = g.projects;
---
<Base title="The Workshop" description="Projects, experiments and small tools." place="workshop">
  <header class="page-head"><div class="wrap"><h1>The Workshop</h1><p>Things I build, break and tune. This is a light showcase; the code itself lives on GitHub.</p></div></header>
  <div class="wrap" style="margin-top:1rem">
    <div class="projects">
      {ordered.map((p) => (
        <article class="project">
          <div>
            <h3>{p.title}</h3>
            <p>{p.description}</p>
            {p.why && <p class="why">{p.why}</p>}
          </div>
          <span class={`pill ${p.status}`}>{p.status}</span>
          <div class="tools-used">
            {p.tech?.map((t) => <span class="chip">{t}</span>)}
            {p.topics?.map((t) => <a class="chip" href={withBase(`curiosities/${slugify(t)}/`)}>{t}</a>)}
          </div>
          <div class="project-actions">
            {p.link && <a class="go" href={p.link} target="_blank" rel="noopener noreferrer">View code on GitHub →</a>}
            {p.article && <a class="article-link" href={p.article} target="_blank" rel="noopener noreferrer">Read writeup on Medium ↗</a>}
          </div>
        </article>
      ))}
    </div>

    {liveApps.length > 0 && (
      <section class="section" style="margin-top: 3.5rem;">
        <div class="section-head">
          <h2>Things you can try</h2>
          <p>Live interactive apps and tools I've built that you can test right now in your browser.</p>
        </div>
        <ul class="rows">
          {liveApps.map((app) => (
            <li class="row" style="grid-template-columns: 1fr auto; align-items: center;">
              <div>
                <h3>
                  <a href={app.link} target="_blank" rel="noopener noreferrer">
                    {app.title} <span style="font-size: 0.85em; opacity: 0.65;">↗</span>
                  </a>
                </h3>
                <p>{app.description}</p>
              </div>
              <a class="btn ghost" href={app.link} target="_blank" rel="noopener noreferrer" style="white-space: nowrap; font-size: 0.88rem; padding: 0.45rem 1rem;">
                Try it live ↗
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {g.experiments.length > 0 && (
      <section class="section">
        <h2>Experiments and small things</h2>
        <ul class="rows">
          {g.experiments.map((e) => (
            <li class="row" style="grid-template-columns:1fr auto">
              <div>
                <h3>{e.link ? <a href={e.link} target="_blank" rel="noopener noreferrer">{e.title}</a> : e.title}</h3>
                <p>{e.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
    <section class="section">
      <h2>More on GitHub</h2>
      <p>Everything else, including open-source experiments and source code, is on <a href="https://github.com/Avijit-D" target="_blank" rel="noopener noreferrer">my GitHub profile (@Avijit-D)</a>.</p>
    </section>
    <Comments id="workshop" title="Workshop Feedback & Ideas" description="Building, tinkering, or have suggestions for these tools? Leave a comment below." />
  </div>
</Base>

<style>
  .project-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    align-items: center;
    margin-top: 0.4rem;
  }
  .project-actions a {
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .project-actions .go {
    color: var(--accent);
  }
  .project-actions .go:hover {
    transform: translateX(3px);
  }
  .project-actions .article-link {
    color: var(--ink-soft);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-underline-offset: 3px;
  }
  .project-actions .article-link:hover {
    color: var(--ink);
    text-decoration: underline;
  }
</style>
