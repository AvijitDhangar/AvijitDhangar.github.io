---
import fs from 'node:fs';
import '../styles/global.css';
import { site } from '../data/site.mjs';
import { withBase } from '../lib/url.mjs';
const { title, description = site.tagline, place = 'home' } = Astro.props;
const full = title ? `${title} · ${site.short}` : `${site.name}: ${site.identity}`;
const nav = [['library', 'Library'], ['workshop', 'Workshop'], ['curiosities', 'Curiosities'], ['about', 'About']];
const path = Astro.url.pathname;
const current = (k) => path.startsWith(withBase(k + '/')) || (k === 'library' && path.startsWith(withBase('series/')));
const ambigram = ['ambigram.svg', 'ambigram.png', 'logo.svg', 'logo.png'].find((f) => fs.existsSync('public/' + f));
const links = [
  site.email && ['Electronic Mail', 'mailto:' + site.email],
  site.github && ['GitHub', site.github],
  site.linkedin && ['LinkedIn', site.linkedin],
  site.simkl && ['Simkl', site.simkl],
  site.medium && ['Medium', site.medium],
].filter(Boolean);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={withBase('rss.xml')} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme') || 'dark';
        document.documentElement.dataset.theme = t;
        document.documentElement.style.backgroundColor = t === 'dark' ? '#071013' : '#f1f8f3';
      } catch (e) {}
    </script>
  </head>
  <body data-place={place}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={withBase('')}>
          {ambigram ? (
            <img src={withBase(ambigram)} alt={site.short} class="nav-ambigram-logo" />
          ) : (
            <><i></i><span>{site.short}</span></>
          )}
        </a>
        <nav class="nav" id="nav" aria-label="Main">
          {nav.map(([k, label]) => <a href={withBase(k + '/')} aria-current={current(k) ? 'page' : undefined}>{label}</a>)}
        </nav>
        <div class="tools">
          <button class="icon-btn" type="button" data-open-search aria-label="Search"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><kbd class="kbd-hide">Ctrl K</kbd></button>
          <button class="icon-btn" type="button" id="theme" aria-label="Switch light or dark theme"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></svg></button>
          <button class="icon-btn menu-btn" type="button" id="menu" aria-expanded="false" aria-controls="nav" aria-label="Menu"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
        </div>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap foot">
        <div class="foot-brand">
          <div><strong>{site.name}</strong><br /><span style="font-style:italic;">{site.footerQuote || site.tagline}</span></div>
        </div>
        <ul>
          <li><a href={withBase('contact/')}>Contact</a></li>
          {links.map(([l, u]) => <li><a href={u} target={u.startsWith('http') ? '_blank' : undefined} rel={u.startsWith('http') ? 'noopener noreferrer' : undefined}>{l}</a></li>)}
          <li><a href={withBase('rss.xml')}>RSS</a></li>
        </ul>
      </div>
    </footer>
    <dialog class="search" id="search" data-index={withBase('search-index.json')} aria-label="Search the site">
      <input type="search" placeholder="Search writing, rabbit holes, projects…" aria-label="Search" autocomplete="off" />
      <ul></ul>
    </dialog>
    <button class="reading-pill" id="reading-pill" type="button" aria-label="Reading progress. Click to scroll to top." title="Scroll to top">
      <svg class="progress-ring" viewBox="0 0 36 36" aria-hidden="true">
        <path class="ring-bg" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
        <path class="ring-fill" id="ring-fill" stroke-dasharray="100, 100" stroke-dashoffset="100" d="M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831"></path>
      </svg>
      <span class="reading-pill-text" id="reading-pill-text">0%</span>
    </button>
  </body>
</html>
<script>
  import '../scripts/site.js';
</script>
